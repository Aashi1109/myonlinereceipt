# Only the Auth deployment receives Better Auth server configuration and secrets.
# PostgreSQL used by Better Auth. Keep secrets empty in source control.
DATABASE_URL=
BETTER_AUTH_SECRET=

# This app and the exact browser origins allowed to call or receive Auth redirects.
BETTER_AUTH_URL=http://localhost:3004
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
AUTH_COOKIE_DOMAIN=

# Public application destinations.
PLATFORM_URL=http://localhost:3000
PAPERWORK_URL=http://localhost:3001
DEVTOOLS_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003

# Verification, recovery, and account-deletion email delivery.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Optional Google OAuth provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
