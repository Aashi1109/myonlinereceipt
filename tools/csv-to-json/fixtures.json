{
  "cases": [
    {
      "input": {
        "primary": "name,role,active\nMaya,Engineer,true\nNoah,Designer,false",
        "secondary": ""
      },
      "name": "converts multiple rows and preserves values as strings",
      "settings": {
        "delimiter": ",",
        "firstRowAsHeaders": true,
        "parseNumbers": false,
        "trimWhitespace": false
      },
      "expected": {
        "downloadName": "data.json",
        "output": "[\n  {\n    \"name\": \"Maya\",\n    \"role\": \"Engineer\",\n    \"active\": \"true\"\n  },\n  {\n    \"name\": \"Noah\",\n    \"role\": \"Designer\",\n    \"active\": \"false\"\n  }\n]",
        "render": "text"
      }
    },
    {
      "input": {
        "primary": "name;note\nMaya;\"Hello; world\"\nNoah;\"She said \"\"hi\"\"\"",
        "secondary": ""
      },
      "name": "parses quoted semicolon-delimited fields",
      "settings": {
        "delimiter": ";",
        "firstRowAsHeaders": true,
        "parseNumbers": false,
        "trimWhitespace": false
      },
      "expected": {
        "downloadName": "data.json",
        "output": "[\n  {\n    \"name\": \"Maya\",\n    \"note\": \"Hello; world\"\n  },\n  {\n    \"name\": \"Noah\",\n    \"note\": \"She said \\\"hi\\\"\"\n  }\n]",
        "render": "text"
      }
    },
    {
      "input": {
        "primary": "name,name\nMaya,Engineer",
        "secondary": ""
      },
      "name": "rejects duplicate headers",
      "settings": {
        "delimiter": ",",
        "firstRowAsHeaders": true,
        "parseNumbers": false,
        "trimWhitespace": false
      },
      "expected": {
        "error": "CSV headers must be unique."
      }
    },
    {
      "input": {
        "primary": " name , score \n Ada , 42 \n Bob , -3.5 ",
        "secondary": ""
      },
      "name": "keeps the first row as data and normalises selected values",
      "settings": {
        "delimiter": ",",
        "firstRowAsHeaders": false,
        "parseNumbers": true,
        "trimWhitespace": true
      },
      "expected": {
        "downloadName": "data.json",
        "output": "[\n  [\n    \"name\",\n    \"score\"\n  ],\n  [\n    \"Ada\",\n    42\n  ],\n  [\n    \"Bob\",\n    -3.5\n  ]\n]",
        "render": "text"
      }
    },
    {
      "input": {
        "primary": "name,score\n Ada , 42 \n  ,  \n Bob , -3.5 ",
        "secondary": ""
      },
      "name": "trims cells and skips rows made empty by trimming",
      "settings": {
        "delimiter": ",",
        "firstRowAsHeaders": true,
        "parseNumbers": true,
        "trimWhitespace": true
      },
      "expected": {
        "downloadName": "data.json",
        "output": "[\n  {\n    \"name\": \"Ada\",\n    \"score\": 42\n  },\n  {\n    \"name\": \"Bob\",\n    \"score\": -3.5\n  }\n]",
        "render": "text"
      }
    }
  ]
}
