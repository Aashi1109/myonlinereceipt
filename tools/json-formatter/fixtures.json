{
  "cases": [
    {
      "input": {
        "primary": "{\"name\":\"Ada\",\"active\":true}",
        "secondary": ""
      },
      "name": "keeps format as the default operation",
      "settings": {
        "indentation": "2"
      },
      "expected": {
        "downloadName": "smarttools-formatted.json",
        "output": "{\n  \"name\": \"Ada\",\n  \"active\": true\n}",
        "render": "json-tree"
      }
    },
    {
      "input": {
        "primary": "{\n  \"name\": \"Ada\",\n  \"active\": true\n}",
        "secondary": ""
      },
      "name": "minifies JSON",
      "settings": {
        "indentation": "2",
        "operation": "minify"
      },
      "expected": {
        "downloadName": "smarttools-minified.json",
        "output": "{\"name\":\"Ada\",\"active\":true}",
        "render": "json-tree"
      }
    },
    {
      "input": {
        "primary": "{\"valid\":true}",
        "secondary": ""
      },
      "name": "validates JSON without reformatting it",
      "settings": {
        "indentation": "2",
        "operation": "validate"
      },
      "expected": {
        "output": "Valid JSON\nRoot type: object",
        "render": "text"
      }
    }
  ]
}
