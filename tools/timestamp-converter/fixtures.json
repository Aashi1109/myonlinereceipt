      "expected": {
        "items": [
          "1704067200 → ISO: 2024-01-01T00:00:00.000Z · UTC: Mon, 01 Jan 2024 00:00:00 GMT · Unix seconds: 1704067200 · Unix milliseconds: 1704067200000",
          "0 → ISO: 1970-01-01T00:00:00.000Z · UTC: Thu, 01 Jan 1970 00:00:00 GMT · Unix seconds: 0 · Unix milliseconds: 0"
        ],
        "render": "list"
      }
