{
  "name": "smarttools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "pnpm --filter @smarttools/platform dev",
    "dev:all": "pnpm --parallel --filter '@smarttools/*' dev",
    "dev:platform": "pnpm --filter @smarttools/platform dev",
    "dev:paperwork": "pnpm --filter @smarttools/paperwork dev",
    "dev:devtools": "pnpm --filter @smarttools/devtools dev",
    "dev:admin": "pnpm --filter @smarttools/admin dev",
    "dev:auth": "pnpm --filter @smarttools/auth-app dev",
    "db:migrate": "pnpm --filter @smarttools/database migrate",
    "admin:promote": "pnpm --filter @smarttools/database promote-admin",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "SMARTTOOLS_INTEGRATION=1 node --test tests/*integration.test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  }
}
